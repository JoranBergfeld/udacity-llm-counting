# Loaded automatically by the VS Code Python/Jupyter extension (python.envFile)
# into every kernel started for this workspace. Mirrors scripts/run_wsl.sh so
# notebook runs match the WSL script environment.
HF_HOME=/home/joran/.cache/huggingface
UNSLOTH_VLLM_NO_FLASHINFER=1
VLLM_USE_FLASHINFER_SAMPLER=0
# No CUDA toolkit (nvcc) in WSL → run training eager instead of torch.compile.
UNSLOTH_COMPILE_DISABLE=1
TORCHDYNAMO_DISABLE=1
PYTHONPATH=/mnt/e/VCS/udacity/udacity-llm-counting/src
